# Copy to .env for local runs. Never commit .env.

# Read-only GitHub token (fine-grained, public repos, no scopes needed).
# In GitHub Actions the built-in token is used automatically.
GITHUB_TOKEN=

# Optional. Unset = local SQLite at data/local.db, rebuilt from data/db/*.jsonl.
# Set to a Neon/Supabase URL to use Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# Optional alerts. Without these, alerts are only written to the change feed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
