---
// One series of weekly columns (<= 24px, 4px rounded tops, square at the baseline). Single series,
// so no legend: the heading names it. Peak week is labelled; every value is in the table view.
interface Props {
  title: string;
  weeks: { week: string; value: number }[];
}
const { title, weeks } = Astro.props;
const W = 640;
const H = 150;
const PAD = { top: 18, right: 8, bottom: 24, left: 28 };
const max = Math.max(1, ...weeks.map((w) => w.value));
const niceMax = max <= 4 ? max : Math.ceil(max / 2) * 2;
const slot = (W - PAD.left - PAD.right) / Math.max(weeks.length, 1);
const barW = Math.min(24, slot - 4);
const plotH = H - PAD.top - PAD.bottom;
const y = (v: number) => PAD.top + plotH * (1 - v / niceMax);
const ticks = Array.from(new Set([0, Math.round(niceMax / 2), niceMax]));
const peak = weeks.reduce((best, w, i) => (w.value > (weeks[best]?.value ?? -1) ? i : best), 0);
const total = weeks.reduce((s, w) => s + w.value, 0);
const short = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
// Rounded top, square base: a path rather than a rect with rx.
const bar = (x: number, top: number, w: number, base: number) => {
  const r = Math.min(4, w / 2, base - top);
  return `M${x},${base} V${top + r} Q${x},${top} ${x + r},${top} H${x + w - r} Q${x + w},${top} ${x + w},${top + r} V${base} Z`;
};
---

{
  total === 0 ? (
    <p class="muted small">Nothing yet for {title.toLowerCase()} in the last {weeks.length} weeks.</p>
  ) : (
    <figure style="margin:0">
      <svg class="viz" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title} per week, last ${weeks.length} weeks`}>
        {ticks.map((t) => (
          <g>
            <line class="grid-line" x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} />
            <text x={PAD.left - 6} y={y(t) + 4} text-anchor="end" class="num">
              {t}
            </text>
          </g>
        ))}
        {weeks.map((w, i) => {
          const cx = PAD.left + slot * i + slot / 2;
          return (
            <g>
              <rect class="hit" x={cx - slot / 2} y={PAD.top} width={slot} height={plotH}>
                <title>{`Week of ${short(w.week)}: ${w.value}`}</title>
              </rect>
              {w.value > 0 && <path class="mark" d={bar(cx - barW / 2, y(w.value), barW, y(0))} fill="var(--viz-accent)" />}
              {i === peak && w.value > 0 && (
                <text x={cx} y={y(w.value) - 5} text-anchor="middle" class="label-strong">
                  {w.value}
                </text>
              )}
              {(i % 4 === 0 || i === weeks.length - 1) && (
                <text x={cx} y={H - 6} text-anchor="middle">
                  {short(w.week)}
                </text>
              )}
            </g>
          );
        })}
      </svg>
      <details class="table-view">
        <summary>Table view</summary>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Week of</th>
                <th class="num">{title}</th>
              </tr>
            </thead>
            <tbody>
              {weeks.map((w) => (
                <tr>
                  <td>{short(w.week)}</td>
                  <td class="num">{w.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </figure>
  )
}
